<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console runner instead of a test framework: no NuGet packages. Exit code 0 when every check passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Aingel.Desktop.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AingelDesktop\AingelDesktop.csproj" />
    <ProjectReference Include="..\AingelSetup\AingelSetup.csproj" />
  </ItemGroup>

</Project>
