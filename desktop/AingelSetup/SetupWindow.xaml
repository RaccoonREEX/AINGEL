<Window x:Class="Aingel.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="White" Foreground="{StaticResource Navy}" FontFamily="Segoe UI">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BackButton" Click="OnCancel" IsCancel="True"/>
            <Button x:Name="NextButton" Click="OnNext" IsDefault="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <!-- What each step says; read by screen readers as it changes. -->
            <TextBlock x:Name="Body" FontSize="15" TextWrapping="Wrap" LineHeight="22" AutomationProperties.LiveSetting="Polite"/>
            <CheckBox x:Name="DesktopBox" Margin="0,14,0,0"/>
            <CheckBox x:Name="LaunchBox" Visibility="Collapsed"/>
            <CheckBox x:Name="PreferencesBox" Visibility="Collapsed"/>
            <ProgressBar x:Name="Progress" Height="8" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="Details" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
