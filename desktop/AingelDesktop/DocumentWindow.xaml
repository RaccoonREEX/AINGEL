<Window x:Class="Aingel.Desktop.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="820" MinWidth="420" MinHeight="480"
        Background="White" Foreground="{StaticResource Navy}" FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="Status" FontSize="14" Margin="0,4,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel>
                <Button x:Name="PreviousButton" Margin="0,4,8,4" Click="OnPrevious"/>
                <Button x:Name="NextButton" Margin="0,4,8,4" Click="OnNext"/>
                <Label x:Name="GoLabel" Target="{Binding ElementName=GoTo}" VerticalAlignment="Center"/>
                <TextBox x:Name="GoTo" Width="70" Margin="0,4,8,4" KeyDown="OnGoKey"/>
                <Button x:Name="GoButton" Margin="0,4,8,4" Click="OnGo"/>
            </WrapPanel>
            <Label x:Name="ChaptersLabel" Target="{Binding ElementName=Chapters}" Padding="0,6,0,2"/>
            <ComboBox x:Name="Chapters" DisplayMemberPath="Label" SelectionChanged="OnChapter"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <WrapPanel>
                <Button x:Name="ReadButton" Margin="0,4,8,4" Click="OnRead"/>
                <Button x:Name="StopButton" Margin="0,4,8,4" Click="OnStop"/>
                <Button x:Name="TranscribeButton" Margin="0,4,8,4" Click="OnTranscribe"/>
            </WrapPanel>
            <WrapPanel>
                <Button x:Name="ExplainButton" Margin="0,4,8,4" Click="OnExplain"/>
                <Button x:Name="SummarizeButton" Margin="0,4,8,4" Click="OnSummarize"/>
                <Button x:Name="FiguresButton" Margin="0,4,8,4" Click="OnFigures"/>
                <Button x:Name="WholeButton" Margin="0,4,8,4" Click="OnWhole"/>
            </WrapPanel>
            <Label x:Name="QuestionLabel" Target="{Binding ElementName=Question}" Padding="0,6,0,2"/>
            <DockPanel>
                <Button x:Name="AskButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnAsk"/>
                <TextBox x:Name="Question" MaxLength="600" KeyDown="OnQuestionKey"/>
            </DockPanel>
            <Label x:Name="SearchLabel" Target="{Binding ElementName=Query}" Padding="0,6,0,2"/>
            <DockPanel>
                <Button x:Name="SearchButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnSearch"/>
                <TextBox x:Name="Query" MaxLength="100" KeyDown="OnSearchKey"/>
            </DockPanel>
            <ListBox x:Name="Results" MaxHeight="120" DisplayMemberPath="Label" MouseDoubleClick="OnResult" KeyDown="OnResultKey" Margin="0,4,0,0"/>
            <Button x:Name="CloseButton" HorizontalAlignment="Left" Click="OnCloseDocument"/>
        </StackPanel>

        <!-- The page, then AI answers, in one read-only box that can be reviewed with the arrows. -->
        <TextBox x:Name="Page" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontSize="17" Margin="0,8,0,0"/>
    </DockPanel>
</Window>
