<Window x:Class="Aingel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="760" MinWidth="340" MinHeight="420" ResizeMode="CanResizeWithGrip"
        Background="White" Foreground="{StaticResource Navy}" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="18">
            <!-- The Thinking Orb: decorative shapes, which UI Automation does not expose; its state is the status text below. -->
            <Grid Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse x:Name="Halo" Width="120" Height="120" Stroke="#F2A900" StrokeThickness="3" Opacity="0.35"/>
                <Ellipse x:Name="Orb" Width="96" Height="96" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop x:Name="OrbLight" Color="#5B8DEF" Offset="0"/>
                            <GradientStop x:Name="OrbDark" Color="#14213D" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="16" Fill="White" Margin="6,0"/>
                    <Ellipse Width="10" Height="16" Fill="White" Margin="6,0"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Status" TextWrapping="Wrap" TextAlignment="Center" FontSize="15" FontWeight="Medium"
                       Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="ModeNote" TextWrapping="Wrap" FontSize="13" Foreground="#8A4B00" Margin="0,0,0,8" Visibility="Collapsed"/>

            <Button x:Name="DescribeWindowButton" Click="OnDescribeWindow"/>
            <Button x:Name="DescribeScreenButton" Click="OnDescribeScreen"/>
            <Button x:Name="MoreDetailButton" Click="OnMoreDetail"/>
            <Button x:Name="ReadFocusButton" Click="OnReadFocus"/>
            <Button x:Name="StopButton" Click="OnStop"/>
            <Button x:Name="OpenDocumentButton" Click="OnOpenDocument"/>
            <Button x:Name="CaptionsButton" Click="OnCaptions"/>

            <Label x:Name="LevelLabel" Target="{Binding ElementName=Level}" Padding="0,10,0,2"/>
            <ComboBox x:Name="Level"/>

            <Label x:Name="QuestionLabel" Target="{Binding ElementName=Question}" Padding="0,10,0,2"/>
            <DockPanel>
                <Button x:Name="AskButton" DockPanel.Dock="Right" Margin="8,0,0,0" HorizontalContentAlignment="Center" Click="OnAsk"/>
                <TextBox x:Name="Question" MaxLength="600" KeyDown="OnQuestionKey"/>
            </DockPanel>

            <Label x:Name="AnswerLabel" Target="{Binding ElementName=Answer}" Padding="0,12,0,2"/>
            <!-- Read-only but focusable: the answer can be reviewed with the arrows, and changes are announced. -->
            <TextBox x:Name="Answer" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MinHeight="140"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontSize="16"
                     AutomationProperties.LiveSetting="Polite"/>

            <!-- Options react to Checked/Unchecked, not Click: UI Automation's Toggle (Narrator, voice control) raises no Click. -->
            <CheckBox x:Name="VoiceBox" Margin="0,12,0,4" Checked="OnVoice" Unchecked="OnVoice"/>
            <TextBlock x:Name="VoiceNote" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
            <CheckBox x:Name="TopmostBox" Checked="OnTopmost" Unchecked="OnTopmost"/>
            <CheckBox x:Name="PrivateBox" Checked="OnPrivate" Unchecked="OnPrivate"/>
            <CheckBox x:Name="SyntheticBox" Checked="OnSynthetic" Unchecked="OnSynthetic"/>

            <TextBlock x:Name="PrivacyNote" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
            <TextBlock x:Name="ShortcutsNote" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            <TextBlock x:Name="Account" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
            <Button x:Name="SignOutButton" Click="OnSignOut" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</Window>
