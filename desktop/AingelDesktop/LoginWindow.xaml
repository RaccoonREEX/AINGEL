<Window x:Class="Aingel.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="White" Foreground="{StaticResource Navy}" FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel x:Name="Credentials">
            <Label x:Name="UserLabel" Target="{Binding ElementName=User}" Padding="0,6,0,2"/>
            <TextBox x:Name="User" MaxLength="150"/>
            <Label x:Name="PasswordLabel" Target="{Binding ElementName=Password}" Padding="0,10,0,2"/>
            <PasswordBox x:Name="Password" MaxLength="256"/>
            <Expander x:Name="ServerExpander" Margin="0,12,0,0">
                <StackPanel>
                    <Label x:Name="ServerLabel" Target="{Binding ElementName=Server}" Padding="0,6,0,2"/>
                    <TextBox x:Name="Server"/>
                </StackPanel>
            </Expander>
            <Button x:Name="SignIn" IsDefault="True" Margin="0,16,0,0" HorizontalContentAlignment="Center" Click="OnSignIn"/>
        </StackPanel>

        <StackPanel x:Name="MfaPanel" Visibility="Collapsed">
            <Label x:Name="MfaLabel" Target="{Binding ElementName=Mfa}" Padding="0,6,0,2"/>
            <TextBox x:Name="Mfa" MaxLength="20"/>
            <Button x:Name="Verify" IsDefault="True" Margin="0,16,0,0" HorizontalContentAlignment="Center" Click="OnVerify"/>
        </StackPanel>

        <StackPanel x:Name="ProfilePanel" Visibility="Collapsed">
            <Label x:Name="ProfileLabel" Target="{Binding ElementName=Profiles}" Padding="0,6,0,2"/>
            <ComboBox x:Name="Profiles" DisplayMemberPath="DisplayName"/>
            <Button x:Name="Continue" IsDefault="True" Margin="0,16,0,0" HorizontalContentAlignment="Center" Click="OnContinue"/>
        </StackPanel>

        <!-- Errors and progress are announced by screen readers as they change. -->
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="14"
                   AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
</Window>
