# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.28-alpine
# The unprivileged image runs nginx as UID 101: the config must be readable by it. --chmod sets that at copy time
# (a later `RUN chmod` would run as that same user and fail on a root-owned file); without it the site answered 502.
COPY --chmod=644 deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
# Start-up check at build time, as the runtime user: nginx must read and accept its configuration.
RUN nginx -t
EXPOSE 8080
